<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="seq_ministry_inspection" model="ir.sequence">
        <field name="name">Ministry Inspection</field>
        <field name="code">ministry.inspection</field>
        <field name="prefix">INS/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

    <record id="seq_ministry_violation" model="ir.sequence">
        <field name="name">Ministry Violation</field>
        <field name="code">ministry.violation</field>
        <field name="prefix">VIO/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>

</odoo>
