<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Portal users see only their federation's plans -->
        <record id="rule_annual_plan_portal" model="ir.rule">
            <field name="name">Annual Plan: Portal Federation Isolation</field>
            <field name="model_id" ref="kaz_ai_ministry_annual_plan.model_ministry_annual_plan"/>
            <field name="domain_force">[('federation_id', '=', user.partner_id.id)]</field>
            <field name="groups" eval="[(4, ref('kaz_ai_ministry_branding.group_ministry_portal'))]"/>
        </record>

        <!-- Company isolation for internal users -->
        <record id="rule_annual_plan_company" model="ir.rule">
            <field name="name">Annual Plan: Company Isolation</field>
            <field name="model_id" ref="kaz_ai_ministry_annual_plan.model_ministry_annual_plan"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
