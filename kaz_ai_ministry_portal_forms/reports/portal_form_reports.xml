<!-- ══════════════════════════════════════════════════════════════
     REPORT 3: Championship Hosting Application
     استمارة استضافة بطولة خارجية
     ══════════════════════════════════════════════════════════════ -->
<template id="report_hosting_document">
    <t t-foreach="docs" t-as="doc">
        <div class="page o_ministry_report" style="direction:rtl; font-family:'NotoSansArabic','Noto Sans Arabic','DejaVu Sans',sans-serif; font-size:10pt; color:#222;">

            <!-- Header -->
            <t t-set="form_title_ar">استمارة استضافة بطولة خارجية</t>
            <t t-set="form_ref">GAS-IMS-OP-07/01-F07  الإصدار 2.0</t>
            <t t-set="form_date_issued" t-value="doc.create_date.strftime('%d/%m/%Y') if doc.create_date else ''"/>
            <t t-call="kaz_ai_ministry_portal_forms.ministry_form_page_header"/>

            <!-- Body table -->
            <table style="width:100%; border-collapse:collapse; font-size:10pt; margin-top:6px;">

                <!-- Row 1: Federation | Event date -->
                <tr style="height:28px;">
                    <td style="width:22%; border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">اسم الاتحاد</td>
                    <td style="width:28%; border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.federation_id.name or ''"/>
                    </td>
                    <td style="width:22%; border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">تاريخ البطولة</td>
                    <td style="width:28%; border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.event_date_start.strftime('%d/%m/%Y') if doc.event_date_start else ''"/>
                        <t t-if="doc.event_date_end"> — <t t-esc="doc.event_date_end.strftime('%d/%m/%Y')"/></t>
                    </td>
                </tr>

                <!-- Row 2: Championship name | Venue -->
                <tr style="height:28px;">
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">اسم البطولة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.championship_name or ''"/>
                    </td>
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">مكان البطولة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.venue or ''"/>
                    </td>
                </tr>

                <!-- Row 3: Organizing body | Expected countries -->
                <tr style="height:28px;">
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">الجهة المنظمة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.organizer or ''"/>
                    </td>
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">عدد الدول المشاركة في اللعبة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.expected_countries or ''"/>
                    </td>
                </tr>

                <!-- Row 4: Championship level (type) | Participant categories -->
                <tr style="height:28px;">
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">تصنيف نوع البطولة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="dict(doc._fields['championship_level'].selection).get(doc.championship_level, '') if doc.championship_level else ''"/>
                    </td>
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">اللغة العربية (رجال / سيدات / ناشئين)</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.participant_categories or ''"/>
                    </td>
                </tr>

                <!-- Row 5: Expected participants | Funding sources -->
                <tr style="height:28px;">
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">عدد اللاعبين المتوقع</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.expected_participants"/>
                    </td>
                    <td style="border:1px solid #bbb; background:#f0f0f0; padding:4px 8px; font-weight:bold; text-align:right;">مصادر تمويل الاستضافة</td>
                    <td style="border:1px solid #bbb; padding:4px 8px; text-align:right;">
                        <t t-esc="doc.funding_sources or ''"/>
                    </td>
                </tr>

                <!-- Row 6: Expected return (highlighted in red, full width) -->
                <tr style="height:50px;">
                    <td style="border:1px solid #bbb; background:#C8102E; padding:4px 8px; font-weight:bold; text-align:right; color:#fff; vertical-align:top;">العائد من الاستضافة</td>
                    <td colspan="3" style="border:1px solid #bbb; padding:4px 8px; text-align:right; vertical-align:top;">
                        <t t-esc="doc.expected_return or ''"/>
                    </td>
                </tr>

            </table>

            <!-- Footer deadline note -->
            <div style="margin-top:14px; font-size:9pt; text-align:right;">
                <span style="font-weight:bold;">ملاحظة: </span>
                <span style="color:#C8102E; font-weight:bold;">يتم إرسال الاستمارة بجميع المتطلبات قبل موعد البطولة 30 يوم</span>
            </div>

            <!-- Confidentiality note -->
            <div style="font-size:8pt; color:#555; margin-top:10px; text-align:right; border-top:1px solid #ddd; padding-top:6px;">
                هذه الوثيقة من الوثائق الداخلية لوزارة الرياضة. لا يجوز نسخ أو توزيع هذه الوثيقة أو الكشف عن أي معلومات واردة فيها لأي طرف ثالث دون الحصول على إذن كتابي مسبق من الوزارة.
            </div>

        </div>
    </t>
</template>

