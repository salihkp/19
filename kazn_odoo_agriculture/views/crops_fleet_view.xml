<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- ===== Form View ===== -->
        <record id="view_crops_fleet_form" model="ir.ui.view">
            <field name="name">crops.fleet.form</field>
            <field name="model">crops.fleet</field>
            <field name="arch" type="xml">
                <form string="Crops Fleet">
                    <sheet>
                        <group>
                            <group>
                                <field name="vehicle_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </group>
                            <group>
                                <field name="quantity"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                            </group>
                        </group>
                        <notebook>
                            <page name="description_page" string="Description">
                                <field name="description"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ===== List View ===== -->
        <record id="view_crops_fleet_list" model="ir.ui.view">
            <field name="name">crops.fleet.list</field>
            <field name="model">crops.fleet</field>
            <field name="arch" type="xml">
                <list string="Crops Fleet">
                    <field name="vehicle_id"/>
                    <field name="start_date"/>
                    <field name="end_date"/>
                    <field name="quantity"/>
                    <field name="description"/>
                </list>
            </field>
        </record>

        <!-- ===== Search View ===== -->
        <record id="view_crops_fleet_search" model="ir.ui.view">
            <field name="name">crops.fleet.search</field>
            <field name="model">crops.fleet</field>
            <field name="arch" type="xml">
                <search string="Crops Fleet">
                    <field name="vehicle_id"/>
                </search>
            </field>
        </record>

        <!-- ===== Action ===== -->
        <record model="ir.actions.act_window" id="action_crops_fleet">
            <field name="name">Crops Fleet</field>
            <field name="res_model">crops.fleet</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
