<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ministry_analytics_alert_list" model="ir.ui.view">
        <field name="name">ministry.analytics.alert.list</field>
        <field name="model">ministry.analytics.alert</field>
        <field name="arch" type="xml">
            <list string="Analytics Alerts" default_order="create_date desc">
                <field name="name"/>
                <field name="alert_type"/>
                <field name="severity" widget="badge"
                    decoration-info="severity == 'info'"
                    decoration-warning="severity == 'warning'"
                    decoration-danger="severity == 'critical'"/>
                <field name="federation_id"/>
                <field name="is_acknowledged"/>
                <field name="acknowledged_by"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>

    <record id="view_ministry_analytics_alert_form" model="ir.ui.view">
        <field name="name">ministry.analytics.alert.form</field>
        <field name="model">ministry.analytics.alert</field>
        <field name="arch" type="xml">
            <form string="Analytics Alert">
                <header>
                    <button name="action_acknowledge" string="Acknowledge" type="object"
                        class="btn-primary"
                        invisible="is_acknowledged"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="alert_type"/>
                            <field name="severity" widget="badge"/>
                            <field name="federation_id"/>
                        </group>
                        <group>
                            <field name="is_acknowledged"/>
                            <field name="acknowledged_by" readonly="1"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <group string="Detail">
                        <field name="detail" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ministry_analytics_alert_search" model="ir.ui.view">
        <field name="name">ministry.analytics.alert.search</field>
        <field name="model">ministry.analytics.alert</field>
        <field name="arch" type="xml">
            <search string="Analytics Alerts">
                <field name="name"/>
                <field name="federation_id"/>
                <filter name="open" string="Open" domain="[('is_acknowledged', '=', False)]"/>
                <filter name="critical" string="Critical" domain="[('severity', '=', 'critical')]"/>
                <group>
                    <filter name="grp_type" string="Type" context="{'group_by': 'alert_type'}"/>
                    <filter name="grp_severity" string="Severity" context="{'group_by': 'severity'}"/>
                    <filter name="grp_federation" string="Federation" context="{'group_by': 'federation_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ministry_analytics_alert" model="ir.actions.act_window">
        <field name="name">Analytics Alerts</field>
        <field name="res_model">ministry.analytics.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ministry_analytics_alert_search"/>
    </record>

</odoo>
