<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Federation Portal Rule: users see only partners linked to their federation -->
        <record id="rule_federation_portal_partner" model="ir.rule">
            <field name="name">Federation Portal: Own Federation Only</field>
            <field name="model_id" ref="base.model_res_partner"/>
            <field name="domain_force">[
                '|',
                '|',
                ('id', '=', user.partner_id.id),
                ('id', '=', user.partner_id.commercial_partner_id.id),
                ('id', 'in', user.partner_id.commercial_partner_id.child_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('kaz_ai_ministry_branding.group_ministry_portal'))]"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Ministry Club company isolation -->
        <record id="rule_ministry_club_company" model="ir.rule">
            <field name="name">Ministry Club: Company Isolation</field>
            <field name="model_id" ref="kaz_ai_ministry_federation.model_ministry_club"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Ministry Sport company isolation -->
        <record id="rule_ministry_sport_company" model="ir.rule">
            <field name="name">Ministry Sport: Company Isolation</field>
            <field name="model_id" ref="kaz_ai_ministry_federation.model_ministry_sport"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        </record>

    </data>
</odoo>
