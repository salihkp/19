<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Company isolation — legal actions -->
    <record id="rule_legal_action_company" model="ir.rule">
        <field name="name">Legal Action: company isolation</field>
        <field name="model_id" ref="model_ministry_legal_action"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <!-- Legal officers can only read/write — no unlink -->
    <record id="rule_legal_action_legal_officer" model="ir.rule">
        <field name="name">Legal Action: legal officer access</field>
        <field name="model_id" ref="model_ministry_legal_action"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('kaz_ai_ministry_branding.group_ministry_legal_officer'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">0</field>
    </record>

</odoo>
