<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pallet_barcode_label" model="report.paperformat">
        <field name="name">Pallet Barcode Label 100x50</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">50</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="report_pallet_barcode" model="ir.actions.report">
        <field name="name">Pallet Barcode Label</field>
        <field name="model">stock.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="report_file">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="paperformat_id" ref="manufacturing_pallet_barcode.paperformat_pallet_barcode_label"/>
        <field name="binding_model_id" ref="stock.model_stock_package"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pallet_barcode_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="package">
                <div class="page" style="width: 100mm; height: 50mm; margin: 0; padding: 0;">
                    <div style="width: 100mm; height: 50mm; border: 1px solid #111; box-sizing: border-box; padding: 2mm 3mm; direction: rtl; font-family: DejaVu Sans, sans-serif; overflow: hidden; page-break-inside: avoid; display: flex; flex-direction: column; gap: 1.2mm;">
                        <div style="text-align: center; direction: ltr; line-height: 1;">
                            <img t-if="package.barcode_image"
                                 t-att-src="package.barcode_image_src"
                                 style="width: 46mm; height: 12mm; display: block; margin: 0 auto;" alt="Barcode"/>
                            <div t-if="not package.barcode_image"
                                 style="width: 46mm; height: 12mm; border: 1px solid #999; margin: 0 auto;"/>
                            <div style="font-size: 8px; margin-top: 0.6mm;">
                                <t t-esc="package.barcode_display or package.name"/>
                            </div>
                        </div>

                        <div t-translation="off" style="font-size: 8.4px; line-height: 1.2; text-align: right;">
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1578;&#1589;&#1606;&#1610;&#1593;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.production_id.name or '-'"/></span>
                            </div>
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.sale_order_ref or '-'"/></span>
                            </div>
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1578;&#1575;&#1585;&#1610;&#1582; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.sale_order_date and package.sale_order_date.strftime('%Y/%m/%d') or '-'"/></span>
                            </div>
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1606;&#1578;&#1580;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.product_id.display_name or '-'"/></span>
                            </div>
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1585;&#1602;&#1605; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.name or '-'"/></span>
                            </div>
                            <div style="white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <strong>&#1603;&#1605;&#1610;&#1577; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</strong>
                                <span style="direction: ltr; unicode-bidi: embed;"><t t-esc="package.product_qty or package.target_qty or 0.0"/></span>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
