        <record id="federation_football" model="res.partner">
            <field name="name">UAE Football Federation</field>
            <field name="is_company">True</field>
            <field name="is_federation">True</field>
            <field name="sport_id" ref="kaz_ai_ministry_federation.sport_football"/>
            <field name="sport_type">team</field>
            <field name="olympic_classification">olympic</field>
            <field name="federation_status">active</field>
