<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit product.template form to add sticker fields -->
    <record id="product_template_form_inherit_pallet" model="ir.ui.view">
        <field name="name">product.template.form.pallet</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="needs_sticker"/>
                <field name="sticker_product_id"
                       invisible="not needs_sticker"/>
            </xpath>
        </field>
    </record>
</odoo>
