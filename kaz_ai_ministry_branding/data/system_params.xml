<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="param_system_name_en" model="ir.config_parameter">
            <field name="key">ministry.system_name_en</field>
            <field name="value">Sports Federation Financial Support Management System</field>
        </record>

        <record id="param_system_name_ar" model="ir.config_parameter">
            <field name="key">ministry.system_name_ar</field>
            <field name="value">نظام إدارة الدعم المالي للاتحادات الرياضية</field>
        </record>

        <record id="param_fiscal_year" model="ir.config_parameter">
            <field name="key">ministry.fiscal_year</field>
            <field name="value">2026</field>
        </record>

        <record id="param_support_email" model="ir.config_parameter">
            <field name="key">ministry.support_email</field>
            <field name="value">support@ministry.gov.ae</field>
        </record>

        <record id="param_annual_budget" model="ir.config_parameter">
            <field name="key">ministry.annual_budget</field>
            <field name="value">50000000</field>
        </record>

        <!-- Risk scoring weights (percentages as integers summing to 100) -->
        <record id="param_risk_weight_budget" model="ir.config_parameter">
            <field name="key">ministry.risk_weight_budget_depletion</field>
            <field name="value">30</field>
        </record>
        <record id="param_risk_weight_variance" model="ir.config_parameter">
            <field name="key">ministry.risk_weight_yoy_variance</field>
            <field name="value">25</field>
        </record>
        <record id="param_risk_weight_history" model="ir.config_parameter">
            <field name="key">ministry.risk_weight_federation_history</field>
            <field name="value">20</field>
        </record>
        <record id="param_risk_weight_reports" model="ir.config_parameter">
            <field name="key">ministry.risk_weight_missing_reports</field>
            <field name="value">15</field>
        </record>
        <record id="param_risk_weight_performance" model="ir.config_parameter">
            <field name="key">ministry.risk_weight_performance</field>
            <field name="value">10</field>
        </record>

    </data>
</odoo>
