<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pallet_barcode_label" model="report.paperformat">
        <field name="name">Pallet Barcode Label 100x50</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">100</field>
        <field name="page_height">50</field>
        <field name="orientation">Landscape</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="disable_shrinking" eval="False"/>
        <field name="dpi">203</field>
    </record>

    <record id="report_pallet_barcode" model="ir.actions.report">
        <field name="name">Pallet Barcode Label</field>
        <field name="model">stock.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="report_file">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="paperformat_id" ref="manufacturing_pallet_barcode.paperformat_pallet_barcode_label"/>
        <field name="binding_model_id" ref="stock.model_stock_package"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pallet_barcode_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="package">
                <div class="page" style="width: 100mm; height: 50mm; margin: 0; padding: 0; overflow: hidden;">
                    <div style="width: 99mm; height: 49mm; margin: 0.5mm; border: 0.24mm solid #111; box-sizing: border-box; direction: rtl; font-family: DejaVu Sans, sans-serif; overflow: hidden; page-break-inside: avoid; background: #fff; padding: 1.7mm 2.2mm 1.2mm;">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 2.4mm; border-bottom: 0.18mm solid #dadada; padding-bottom: 1.2mm; margin-bottom: 1mm;">
                            <div style="width: 58mm; text-align: center; direction: ltr; line-height: 1;">
                                <img t-if="package.barcode_image"
                                     t-att-src="package.barcode_image_src"
                                     style="width: 56mm; height: 12.5mm; display: block; margin: 0 auto;" alt="Barcode"/>
                                <div t-if="not package.barcode_image"
                                     style="width: 56mm; height: 12.5mm; border: 0.18mm solid #999; margin: 0 auto;"/>
                                <div style="font-size: 8.2px; font-weight: 700; letter-spacing: 0.18px; margin-top: 0.55mm;">
                                    <t t-esc="package.barcode_display or package.name"/>
                                </div>
                            </div>

                            <div t-translation="off" style="flex: 1; min-width: 0; text-align: right; font-size: 7.4px; line-height: 1.15;">
                                <div style="font-weight: 700; color: #111; white-space: nowrap;">&#1585;&#1602;&#1605; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</div>
                                <div style="direction: ltr; text-align: left; font-size: 8px; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <t t-esc="package.name or '-'"/>
                                </div>
                                <div style="font-weight: 700; color: #111; margin-top: 0.55mm; white-space: nowrap;">&#1603;&#1605;&#1610;&#1577; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</div>
                                <div style="direction: ltr; text-align: left; font-size: 8px; font-weight: 700; white-space: nowrap;">
                                    <t t-esc="package.product_qty or package.target_qty or 0.0"/>
                                </div>
                            </div>
                        </div>

                        <table t-translation="off" style="width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 7.55px; line-height: 1.18;">
                            <tbody>
                                <tr style="border-bottom: 0.15mm solid #ececec;">
                                    <td style="width: 31%; font-weight: 700; color: #111; white-space: nowrap; padding: 0.35mm 0;">&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1578;&#1589;&#1606;&#1610;&#1593;:</td>
                                    <td style="width: 69%; direction: ltr; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0.35mm 0;">
                                        <t t-esc="package.production_id.name or '-'"/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 0.15mm solid #ececec;">
                                    <td style="width: 31%; font-weight: 700; color: #111; white-space: nowrap; padding: 0.35mm 0;">&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</td>
                                    <td style="width: 69%; direction: ltr; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0.35mm 0;">
                                        <t t-esc="package.sale_order_ref or '-'"/>
                                    </td>
                                </tr>
                                <tr style="border-bottom: 0.15mm solid #ececec;">
                                    <td style="width: 31%; font-weight: 700; color: #111; white-space: nowrap; padding: 0.35mm 0;">&#1578;&#1575;&#1585;&#1610;&#1582; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</td>
                                    <td style="width: 69%; direction: ltr; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding: 0.35mm 0;">
                                        <t t-esc="package.sale_order_date and package.sale_order_date.strftime('%Y/%m/%d') or '-'"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td style="width: 31%; font-weight: 700; color: #111; white-space: nowrap; padding-top: 0.45mm;">&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1606;&#1578;&#1580;:</td>
                                    <td style="width: 69%; direction: ltr; text-align: left; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 7.35px; padding-top: 0.45mm;">
                                        <t t-esc="package.product_id.display_name or '-'"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
