<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ministry_sport_list" model="ir.ui.view">
        <field name="name">ministry.sport.list</field>
        <field name="model">ministry.sport</field>
        <field name="arch" type="xml">
            <list string="Sports">
                <field name="name"/>
                <field name="code"/>
                <field name="is_olympic" widget="boolean_toggle"/>
                <field name="federation_count"/>
            </list>
        </field>
    </record>

    <record id="view_ministry_sport_form" model="ir.ui.view">
        <field name="name">ministry.sport.form</field>
        <field name="model">ministry.sport</field>
        <field name="arch" type="xml">
            <form string="Sport">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="code"/>
                            <field name="is_olympic"/>
                        </group>
                        <group>
                            <field name="federation_count"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_ministry_sport" model="ir.actions.act_window">
        <field name="name">Sports</field>
        <field name="res_model">ministry.sport</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No sports defined yet</p>
            <p>Add the sports that federations in this system govern.</p>
        </field>
    </record>

</odoo>
