<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_production_form_inherit" model="ir.ui.view">
        <field name="name">mrp.production.form.pallet</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <!-- Stat button in button_box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_pallets"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-th">
                    <field name="pallet_count" widget="statinfo" string="Pallets"/>
                </button>
            </xpath>

            <!-- Action buttons in header -->
            <xpath expr="//button[@name='button_mark_done']" position="before">
                <field name="is_sticker_stage" invisible="1"/>
                <button name="action_create_pallet"
                        type="object"
                        string="Create Pallet"
                        class="oe_highlight"
                        invisible="state in ('done', 'cancel')"/>
                <button name="action_mark_sticker_applied"
                        type="object"
                        string="Confirm Sticker"
                        class="btn btn-success"
                        invisible="not is_sticker_stage or state in ('done', 'cancel')"/>
            </xpath>

            <!-- Sticker product field in the form body -->
            <xpath expr="//field[@name='product_id']" position="after">
                <field name="sticker_product_id"
                       placeholder="Select sticker product..."
                       invisible="state in ('done', 'cancel')"
                       options="{'no_create': True}"/>
            </xpath>

            <!-- Pick Packages button before components -->
            <xpath expr="//page[@name='components']//field[@name='move_raw_ids']" position="before">
                <button name="action_pick_packages"
                        type="object"
                        string="Pick Packages"
                        class="btn btn-secondary mb-2"
                        icon="fa-cubes"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
        </field>
    </record>
</odoo>
