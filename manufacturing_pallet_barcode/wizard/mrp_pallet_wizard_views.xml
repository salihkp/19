<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_pallet_wizard_form_view" model="ir.ui.view">
        <field name="name">mrp.pallet.wizard.form</field>
        <field name="model">mrp.pallet.wizard</field>
        <field name="arch" type="xml">
            <form string="Create Pallet">
                <group>
                    <field name="production_id" invisible="1"/>
                    <field name="location_dest_id" invisible="1"/>
                    <field name="product_id" readonly="1"/>
                    <field name="use_existing_package"/>
                    <field name="existing_package_id" 
                           invisible="not use_existing_package" 
                           required="use_existing_package"/>
                    <field name="company_id" invisible="1"/>
                    <field name="package_type_id"/>
                    <field name="total_quantity"/>
                    <field name="capacity_per_pallet" invisible="use_existing_package"/>
                </group>
                <footer>
                    <button name="action_create_pallet" string="Create" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
