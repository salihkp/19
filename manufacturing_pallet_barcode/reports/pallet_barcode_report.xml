<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="paperformat_pallet_barcode_label" model="report.paperformat">
        <field name="name">Pallet Barcode Label 50x100 (Lengthwise)</field>
        <field name="default" eval="False"/>
        <field name="format">custom</field>
        <field name="page_width">50</field>
        <field name="page_height">100</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">0</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="header_line" eval="False"/>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">96</field>
    </record>

    <record id="report_pallet_barcode" model="ir.actions.report">
        <field name="name">Pallet Barcode Label</field>
        <field name="model">stock.package</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="report_file">manufacturing_pallet_barcode.report_pallet_barcode_template</field>
        <field name="paperformat_id" ref="manufacturing_pallet_barcode.paperformat_pallet_barcode_label"/>
        <field name="binding_model_id" ref="stock.model_stock_package"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_pallet_barcode_single_label">
        <div class="o_pallet_label_card">
            <div class="o_pallet_label_barcode_zone">
                <img t-if="package.barcode_image"
                     t-att-src="package.barcode_image_src"
                     class="o_pallet_label_barcode" alt="Barcode"/>
                <div t-if="not package.barcode_image" class="o_pallet_label_barcode_fallback"/>
                <div class="o_pallet_label_code_text">
                    <t t-esc="package.barcode_display or package.name"/>
                </div>
            </div>

            <table t-translation="off" class="o_pallet_label_meta_table">
                <tbody>
                    <tr>
                        <td class="o_pallet_label_value"><t t-esc="package.name or '-'"/></td>
                        <td class="o_pallet_label_key">&#1585;&#1602;&#1605; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</td>
                    </tr>
                    <tr>
                        <td class="o_pallet_label_value"><t t-esc="package.pallet_qty or package.target_qty or package.product_qty or 0.0"/></td>
                        <td class="o_pallet_label_key">&#1603;&#1605;&#1610;&#1577; &#1575;&#1604;&#1591;&#1576;&#1604;&#1610;&#1577;:</td>
                    </tr>
                    <tr>
                        <td class="o_pallet_label_value"><t t-esc="package.production_id.name or '-'"/></td>
                        <td class="o_pallet_label_key">&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1578;&#1589;&#1606;&#1610;&#1593;:</td>
                    </tr>
                    <tr>
                        <td class="o_pallet_label_value"><t t-esc="package.sale_order_ref or '-'"/></td>
                        <td class="o_pallet_label_key">&#1585;&#1602;&#1605; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</td>
                    </tr>
                    <tr>
                        <td class="o_pallet_label_value"><t t-esc="package.sale_order_date and package.sale_order_date.strftime('%Y/%m/%d') or '-'"/></td>
                        <td class="o_pallet_label_key">&#1578;&#1575;&#1585;&#1610;&#1582; &#1571;&#1605;&#1585; &#1575;&#1604;&#1576;&#1610;&#1593;:</td>
                    </tr>
                    <tr>
                        <td class="o_pallet_label_value o_pallet_label_value_product"><t t-esc="package.product_id.display_name or '-'"/></td>
                        <td class="o_pallet_label_key">&#1575;&#1587;&#1605; &#1575;&#1604;&#1605;&#1606;&#1578;&#1580;:</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </template>

    <template id="report_pallet_barcode_template">
        <t t-set="full_width" t-value="True"/>
        <t t-call="web.report_layout">
            <style>
                @page {
                    size: 50mm 100mm;
                    margin: 0;
                }
                html, body, #wrapwrap, #wrapwrap main {
                    width: 100% !important;
                    height: 100% !important;
                    margin: 0 !important;
                    padding: 0 !important;
                }
                body.o_body_html,
                body.o_body_pdf {
                    margin: 0 !important;
                    padding: 0 !important;
                }
                body.o_body_html.container,
                body.o_body_html.container-fluid {
                    max-width: 100% !important;
                    padding: 0 !important;
                }
                .o_pallet_sheet {
                    width: 50mm;
                    height: 100mm;
                    margin: 0;
                    padding: 0;
                    overflow: hidden;
                    page-break-inside: avoid;
                }
                .o_pallet_label_card {
                    width: 50mm;
                    height: 100mm;
                    box-sizing: border-box;
                    direction: ltr;
                    font-family: DejaVu Sans, sans-serif;
                    background: #fff;
                    overflow: hidden;
                    padding: 1.4mm 1.2mm 1.0mm;
                }
                .o_pallet_label_barcode_zone {
                    height: 24mm;
                    text-align: center;
                    direction: ltr;
                    line-height: 1;
                    border-bottom: 0.14mm solid #dddddd;
                    padding: 1.0mm 0 0.9mm;
                    margin-bottom: 0.8mm;
                }
                .o_pallet_label_barcode {
                    width: 44mm;
                    height: 13.2mm;
                    display: block;
                    margin: 0 auto;
                }
                .o_pallet_label_barcode_fallback {
                    width: 44mm;
                    height: 13.2mm;
                    border: 0.16mm solid #999;
                    margin: 0 auto;
                }
                .o_pallet_label_code_text {
                    font-size: 8.2px;
                    font-weight: 700;
                    letter-spacing: 0.1px;
                    margin-top: 0.8mm;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .o_pallet_label_meta_table {
                    width: 100%;
                    height: 72mm;
                    border-collapse: collapse;
                    table-layout: fixed;
                    direction: ltr;
                    font-size: 8.0px;
                    line-height: 1.05;
                }
                .o_pallet_label_meta_table tr {
                    height: 12mm;
                    border-bottom: 0.11mm dashed #e6e6e6;
                }
                .o_pallet_label_meta_table tr:last-child {
                    border-bottom: none;
                }
                .o_pallet_label_key {
                    width: 43%;
                    direction: rtl;
                    text-align: right;
                    font-weight: 700;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    padding: 0 0.2mm 0 0.6mm;
                    vertical-align: middle;
                }
                .o_pallet_label_value {
                    width: 57%;
                    direction: ltr;
                    text-align: left;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                    padding: 0 0.6mm 0 0;
                    vertical-align: middle;
                }
                .o_pallet_label_value_product {
                    font-size: 7.6px;
                }
            </style>

            <t t-foreach="docs" t-as="package">
                <div class="o_pallet_sheet" t-att-style="not package_last and 'page-break-after: always;' or ''">
                    <t t-call="manufacturing_pallet_barcode.report_pallet_barcode_single_label"/>
                </div>
            </t>
        </t>
    </template>
</odoo>
